# Supabase Postgres connection string (Project Settings → Database → Connection string → URI)
# Used only by the legacy Drizzle-managed tables (subscriber, order, commission_request).
DATABASE_URL=

# Used to build OAuth/email-confirmation redirect URLs. The live domain
# is still undecided (see IMPLEMENTATION.md) — set to whatever origin
# this actually deploys to.
NEXT_PUBLIC_SITE_URL=

# Supabase Auth / Articles / admin — Project Settings → API. Publishable
# (anon) key only; NEVER put the service-role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by admin server actions (role changes, bans,
# hard-deletes, audit log writes). Never exposed to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Supabase Auth) — register a client in Google Cloud
# Console, add the redirect URL to both Google's console and Supabase
# Auth settings. The "Continue with Google" button is wired but will
# error until these are set — see IMPLEMENTATION.md.
# (Configured directly in the Supabase dashboard's Auth → Providers,
# not as an app env var — listed here as a reminder that it's pending.)

# Resend (transactional email — the Primer letter sequence)
RESEND_API_KEY=

# Razorpay (India checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe (rest-of-world checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile (bot protection on the two forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 (brief PDFs, presigned URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
